///////////////////////////////////////////////////////////////////////////////
// Restore Abandoned Zoo: stock Zoo capture front half plus Hooligan delivery
//
// The private Capture Flag preserves its target's own death callback.  Lethal
// damage runs the abandoned expansion Zoo roll and actual Control_Monster
// lifecycle; a successful control then enters the already-proven Wizard's
// Curse Hooligan return and Mausoleum-shaped Zoo storage lifecycle.
///////////////////////////////////////////////////////////////////////////////

// DataMX/mx_gpltext.cam reserves slots 177-199 as "empty".  Use one of those
// shipped placeholders for the Zoo occupant intent without replacing a live
// stock intent or quest message.
expression #intent_waiting_in_zoo 199
expression #intent_capturing_monster 198
expression #intent_renting_beast 197

// Stock Garrison_Scan_Or_Leave rolls 1..100 with a strict less-than
// comparison. A threshold of 6 therefore gives an effective 5% chance on each
// 60-second stored-occupant check.
expression #Restore_Zoo_Breakout_Threshold 6
expression #Restore_Zoo_Breakout_Period 60000

///////////////////////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Threat_Rank ( agent visitor ) is integer
///////////////////////////////////////////////////////////////////////////////
// The stock combat bounty is the only generic designer-authored monster
// strength scalar. These are the same approximate XP quantiles used by the
// Generic Visitor Lists display patch; no title table is required.
declare
	integer experience;
begin
	experience = $GetAttribute ( visitor, #ATTRIB_LevelXP );

	if ( experience <= 230 )
		return 1;
	else if ( experience <= 400 )
		return 2;
	else if ( experience <= 500 )
		return 3;
	else if ( experience <= 900 )
		return 4;
	else if ( experience <= 1500 )
		return 5;
	else if ( experience <= 2000 )
		return 6;
	else if ( experience <= 3500 )
		return 7;

	return 8;
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Tame_Cost ( agent visitor ) is integer
///////////////////////////////////////////////////////////////////////////////
// Stock Mausoleum_Resurrect_Cost is a selected-occupant cost callback. The Zoo
// uses the same callback boundary, replacing hero level with the generic
// LevelXP-derived Threat Rank already used by the visitor display and revenue.
// The 500-gold step is invented Zoo balance: ranks 1-8 cost 500-4000 gold.
declare
begin
	if ( $IsValidGamePiece ( visitor ) == FALSE )
		return 0;
	if ( visitor's "Original_Type" != "Monster" )
		return 0;

	return $Restore_Zoo_Threat_Rank ( visitor ) * 500;
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Is_Stored_Captive (
	agent visitor, agent zoo ) is boolean
///////////////////////////////////////////////////////////////////////////////
// Use the stock Original_Type discriminator to separate subdued monsters from
// ordinary heroes temporarily visiting the Zoo through Use_Building.
declare
begin
	if ( $IsValidGamePiece ( visitor ))
		if ( visitor's "Original_Type" == "Monster" )
			if ( $GetBuildingContainer ( visitor ) == zoo )
				if ( $AgentInList ( visitor, zoo's "Occupants" ))
					return TRUE;

	return FALSE;
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Captive_Count ( agent zoo ) is integer
///////////////////////////////////////////////////////////////////////////////
// Rental visits add the visiting hero to Occupants through the literal stock
// Use_Building lifecycle. Count only the monster occupants owned by the Zoo.
declare
	list visitors;
	agent visitor;
	integer count;
begin
	visitors = zoo's "Occupants";
	count = 0;

	foreach visitor in visitors do
		begin
			if ( $Restore_Zoo_Is_Stored_Captive ( visitor, zoo ))
				count ++;
		end

	return count;
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Find_Rentable_Captive (
	agent zoo, agent buyer ) is agent
///////////////////////////////////////////////////////////////////////////////
// Stock shopping selects from affordable offers before committing to a visit.
// Among the Zoo's affordable occupants, select the highest priced (and thus
// highest Threat Rank) captive so a wealthier hero can obtain a stronger ally.
declare
	list visitors;
	agent visitor, selected;
	integer available_gold, cost, selected_cost;
begin
	visitors = zoo's "Occupants";
	available_gold = $Total_Gold ( buyer );
	selected = $NullAgent ();
	selected_cost = 0;

	foreach visitor in visitors do
		begin
			if ( $Restore_Zoo_Is_Stored_Captive ( visitor, zoo ))
				if ( $IsDead ( visitor ) == FALSE )
					begin
						cost = $Restore_Zoo_Tame_Cost ( visitor );
						if ( cost <= available_gold && cost > selected_cost )
							begin
								selected = visitor;
								selected_cost = cost;
							end
					end
		end

	return selected;
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Rental_Check ( agent thisagent ) is boolean
///////////////////////////////////////////////////////////////////////////////
// This callback belongs at the final false branch of stock Purchase_Bazaar.
// Heroes therefore consider all ordinary equipment, permanent upgrades, and
// Magic Bazaar items first. Its random decision copies Stat_Boost_Check's
// shipped 1..100 comparison and percentage constant.
declare
	list zoos, rentable_zoos;
	agent zoo, captive;
	integer search_dist;
begin
	// Stock Control_Monster accounts for followers on the hero. Ordinary heroes
	// may rent one beast; existing Cultist/Priestess followers keep them out.
	if ( thisagent's "Num_Followers" > 0 )
		return FALSE;

	if ( $RandomNumber ( 100 ) + 1 >= #Percent_Chance_To_Buy_Stats )
		return FALSE;

	search_dist = $GetAttribute ( thisagent, #ATTRIB_SightRange ) *
		( $GetAttribute ( thisagent, #ATTRIB_Intelligence ) / 2 );
	$ListObjects ( thisagent, "building", search_dist, zoos,
		#MyPlayer, #CheckTitles, "Zoo", #ATTRIB_FirstStageBuilt, 1 );

	foreach zoo in zoos do
		begin
			if ( $GetAttribute ( zoo, #ATTRIB_EmbassyActiveFlag ) != 0 )
				begin
					captive = $Restore_Zoo_Find_Rentable_Captive (
						zoo, thisagent );
					if ( $IsValidGamePiece ( captive ))
						rentable_zoos << zoo;
				end
		end

	if ( $ListSize ( rentable_zoos ) > 0 )
		begin
			thisagent's "Target" = $Loyalty_Mod_Pick_Closest (
				thisagent, rentable_zoos );
			thisagent's "TaskName" = "Rent_Beast";
			$SpecifyIntent ( thisagent, #intent_renting_beast );
			return TRUE;
		end

	return FALSE;
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Start_Rented_Beast (
	agent captive, agent buyer, agent zoo )
///////////////////////////////////////////////////////////////////////////////
// Mausoleum_Resurrect_Begin supplies the stored-agent removal boundary;
// Mausoleum_Resurrect_Finish supplies the new ActiveScript thread start. The
// released monster then enters the literal stock Cultist Control_Monster path.
declare
begin
	$SpecifyIntent ( captive, #Intent_Thinking );
	$ClearEngineDeathFlags ( captive );
	$KillThread ( captive's "ActiveScript" );
	zoo's "Occupants" -= captive;
	$Unhide ( captive );

	$SetAttribute (
		captive, #ATTRIB_HP, $GetAttribute ( captive, #ATTRIB_MaxHP ));
	$SetAttribute ( captive, #ATTRIB_NotFlaggable, 0 );
	$SetAttribute ( captive, #ATTRIB_NotSpellTarget, 0 );
	captive's "leader" = $NullAgent ();
	captive's "Target" = $NullAgent ();
	captive's "Special_Boolean" = FALSE;

	$Control_Monster ( buyer, captive );
	$NewThread ( captive's "ActiveScript", #Normal_Cycle, captive );
	$Restore_Refresh_Zoo_Capacity ( zoo );
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Complete_Rental ( agent thisagent )
///////////////////////////////////////////////////////////////////////////////
// Stock Obtain_Upgrade revalidates and pays after the visit delay, then hands
// off to a final exit task. Do the same so closing rentals, a breakout, another
// buyer, or a new follower acquired in transit safely cancels the purchase.
declare
	agent zoo, captive;
	integer cost;
begin
	zoo = thisagent's "Target";
	$SetThreadInterval ( thisagent's "ActiveScript", #Normal_Cycle );

	if ( $IsValidGamePiece ( zoo ))
		if ( $IsDead ( zoo ) == FALSE )
			if ( $GetAttribute ( zoo, #ATTRIB_EmbassyActiveFlag ) != 0 )
				if ( thisagent's "Num_Followers" == 0 )
					begin
						captive = $Restore_Zoo_Find_Rentable_Captive (
							zoo, thisagent );
						if ( $IsValidGamePiece ( captive ))
							begin
								cost = $Restore_Zoo_Tame_Cost ( captive );
								if ( $Total_Gold ( thisagent ) >= cost )
									begin
										$Spend_Gold ( thisagent, zoo, cost );
										$Restore_Zoo_Start_Rented_Beast (
											captive, thisagent, zoo );
									end
							end
					end

	thisagent's "ActiveScript" = $Restore_Zoo_Finish_Rental;
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Finish_Rental ( agent thisagent )
///////////////////////////////////////////////////////////////////////////////
// Literal Done_Enhancing_Equipment exit/reset shape without its blacksmith
// effects or Palace trip counter.
declare
	agent zoo;
begin
	zoo = thisagent's "Target";
	$Exit_Building ( thisagent, zoo );
	if ( $IsValidGamePiece ( zoo ))
		$Restore_Refresh_Zoo_Capacity ( zoo );
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Visited ( agent thisagent )
///////////////////////////////////////////////////////////////////////////////
// Use_Building dispatches through the target's Visited_Script. Rental keeps the
// exact Upgrade_Equipment visit-duration shape; any non-rental visit retains
// the abandoned Zoo's shipped Upgrade_Equipment callback.
declare
begin
	if ( thisagent's "TaskName" == "Rent_Beast" )
		begin
			$Enter_Building ( thisagent, thisagent's "Target" );
			$SetThreadInterval (
				thisagent's "ActiveScript", #Upgrade_Equipment_Visit_Duration );
			thisagent's "ActiveScript" = $Restore_Zoo_Complete_Rental;
		end
	else
		$Upgrade_Equipment ( thisagent );
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Tame_Beast ( agent thisagent )
///////////////////////////////////////////////////////////////////////////////
// Stock Mausoleum resurrection removes the selected agent from its containing
// building, unhides it, restores its live task slots, and starts the new active
// thread. The controlled Varg in Epic_Quest_Scripts is the stock state model
// for the released beast: Hero/Controlled classification, Monster EnemyType,
// Guardian in every task slot, and a fixed home coordinate. Stock monster data
// normally supplies Guardian_Mod 5; expansion Palace guards use combat sight
// 250. Those stock inputs make the generic tame useful outside one doorstep.
// The Palace is the kingdom-wide defensive anchor; the Zoo remains the safe
// fallback if its player has no valid Palace.
declare
	agent zoo, palace;
begin
	zoo = $GetBuildingContainer ( thisagent );
	if ( $IsValidGamePiece ( zoo ) == FALSE )
		return;
	if ( zoo's "Title" != "Zoo" )
		return;
	if ( $Restore_Zoo_Is_Stored_Captive ( thisagent, zoo ) == FALSE )
		return;

	$SpecifyIntent ( thisagent, #intent_patrolling_city );
	$ClearEngineDeathFlags ( thisagent );
	$KillThread ( thisagent's "ActiveScript" );
	zoo's "Occupants" -= thisagent;
	$Unhide ( thisagent );

	thisagent's "Type" = "Hero";
	thisagent's "Original_Type" = "Hero";
	thisagent's "SubType" = "Controlled";
	thisagent's "EnemyType" = "Monster";
	thisagent's "Guardian_Mod" = 5;
	if ( $GetAttribute ( thisagent, #ATTRIB_SightRange ) < 250 )
		$SetAttribute ( thisagent, #ATTRIB_SightRange, 250 );
	palace = $GetTruePalace ( zoo );
	if ( $IsValidGamePiece ( palace ))
		thisagent's "coord_home" = $LocationOf ( palace );
	else
		thisagent's "coord_home" = $LocationOf ( zoo );
	thisagent's "leader" = $NullAgent ();
	thisagent's "Target" = $NullAgent ();
	$ClearList ( thisagent's "Hostiles" );
	$SetUnitPlayerNumber ( thisagent, $GetUnitPlayerNumber ( zoo ));
	$SetAttribute (
		thisagent, #ATTRIB_HP, $GetAttribute ( thisagent, #ATTRIB_MaxHP ));
	$SetAttribute ( thisagent, #ATTRIB_NotFlaggable, 1 );
	$SetAttribute ( thisagent, #ATTRIB_NotSpellTarget, 1 );

	thisagent's "BasicScript" = $Guardian;
	thisagent's "BackScript" = $Guardian;
	thisagent's "ActiveScript" = $Guardian;
	$NewThread ( thisagent's "ActiveScript", #Normal_Cycle, thisagent );
	$Restore_Refresh_Zoo_Capacity ( zoo );
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Revenue ( agent thisagent )
///////////////////////////////////////////////////////////////////////////////
// Stock Fairgrounds_Revenue reads a building-owned participant list, computes
// one pulse, and gives that gold to the building for ordinary tax collection.
// The Zoo uses the same lifecycle but weights each valid Occupants entry by
// the captured monster's stock LevelXP-derived threat rank. Do not apply a
// living/dead filter here: stock capture deliberately preserves its subdued
// state while the valid agent is hidden inside the Zoo.
declare
	agent palace, visitor;
	list visitors;
	integer revenue;
begin
	palace = $GetTruePalace ( thisagent );
	revenue = 0;

	if ( $IsValidGamePiece ( palace ))
		begin
			visitors = thisagent's "Occupants";
			foreach visitor in visitors do
				begin
					if ( $Restore_Zoo_Is_Stored_Captive (
						visitor, thisagent ))
						revenue += thisagent's "Revenue_Amount" *
							$Restore_Zoo_Threat_Rank ( visitor );
				end

			if ( revenue > 0 )
				$Give_Gold ( thisagent, revenue );
		end
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Release_Captive ( agent captive, agent zoo )
///////////////////////////////////////////////////////////////////////////////
// Stock Reset_Controlled is the shipped charm-expiry path: it restores the
// monster's StartingScript, Monster_Player ownership, monster death callback,
// and hostile classification. Heal before the stock Exit_Building lifecycle
// unhides it and resets its task pointers. The stored captive retains a running
// stock-shaped garrison task, so Exit_Building can return it to BasicScript.
declare
begin
	$Reset_Controlled ( captive );
	$SetAttribute (
		captive, #ATTRIB_HP, $GetAttribute ( captive, #ATTRIB_MaxHP ));
	$SetAttribute ( captive, #ATTRIB_NotFlaggable, 0 );
	$SetAttribute ( captive, #ATTRIB_NotSpellTarget, 0 );
	captive's "leader" = $NullAgent ();
	captive's "Target" = $NullAgent ();
	$Exit_Building ( captive, zoo );
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Breakout_Check ( agent thisagent )
///////////////////////////////////////////////////////////////////////////////
// Literal Garrison_Scan_Or_Leave random-exit shape, with the Guardhouse
// container replaced by the containing Zoo and the ordinary hero exit replaced
// by the already-proven hostile captive release lifecycle.
declare
	agent zoo;
begin
	zoo = $GetBuildingContainer ( thisagent );

	if ( $IsValidGamePiece ( zoo ))
		if ( $IsDead ( zoo ) == FALSE )
			if (( $RandomNumber ( 100 ) + 1 ) <
				#Restore_Zoo_Breakout_Threshold )
				begin
					$Restore_Zoo_Release_Captive ( thisagent, zoo );
					$Restore_Refresh_Zoo_Capacity ( zoo );
				end
end

///////////////////////////////////////////////////////////////////////////////
function release_occupants ( agent thisagent )
///////////////////////////////////////////////////////////////////////////////
// Literal Northern Expansion release_occupants structure, extended beside its
// living-Mausoleum exception with the equivalent living-Zoo exception. The
// ordinary and Mausoleum branches retain their shipped statement order.
declare
	list guys;
	agent guy;
	boolean private_zoo;
begin
	if ( $HasAttribute ( "Occupants", thisagent ))
		if ( $ListSize ( thisagent's "Occupants" ) > 0 )
			begin
				private_zoo = FALSE;
				if ( thisagent's "Title" == "Zoo" )
					if ( $HasAttribute ( "RevenueScript", thisagent ))
						if ( thisagent's "RevenueScript" == $Restore_Zoo_Revenue )
							private_zoo = TRUE;

				if ( private_zoo )
					begin
						if ( $IsDead ( thisagent ))
							begin
								guys = thisagent's "Occupants";
							foreach guy in guys do
									begin
										if ( $IsValidGamePiece ( guy ))
											begin
												if ( $Restore_Zoo_Is_Stored_Captive (
													guy, thisagent ))
													$Restore_Zoo_Release_Captive (
														guy, thisagent );
												else if ( $IsDead ( guy ) == FALSE )
													$Exit_Building ( guy, thisagent );
												else
													$Be_Dead ( guy );

												thisagent's "Occupants" -= guy;
											end
									end
							end
					end
				else if ( thisagent's "Title" != "Mausoleum" )
					begin
						guys = thisagent's "Occupants";
						foreach guy in guys do
							begin
								if ( $IsValidGamePiece ( guy ))
									begin
										if ( $IsDead ( guy ) == FALSE )
											begin
												$Exit_Building ( guy, thisagent );
												thisagent's "Occupants" -= guy;
											end
										else
											begin
												$Be_Dead ( guy );
												thisagent's "Occupants" -= guy;
											end
									end
								else
									$DebugOut ( 911,
										"INVALID OCCUPANT FOUND INSIDE BUILDING: ",
										thisagent, "!!!" );
							end
					end
				else if ( $IsDead ( thisagent ))
					begin
						guys = thisagent's "Occupants";
						foreach guy in guys do
							begin
								if ( $IsValidGamePiece ( guy ))
									begin
										$Be_Dead ( guy );
										thisagent's "Occupants" -= guy;
									end
							end
					end
			end
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Visitor_Limit ( agent zoo ) is integer
///////////////////////////////////////////////////////////////////////////////
// The building's shipped Level field is the stock source for upgrade state.
// Capacity values are the requested Zoo design: 4 / 6 / 8.
declare
begin
	if ( zoo's "Level" >= 3 )
		return 8;
	else if ( zoo's "Level" == 2 )
		return 6;

	return 4;
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Is_Latched_Capture ( agent hooligan ) is boolean
///////////////////////////////////////////////////////////////////////////////
// A pending slot exists only while the stock arrest handoff is genuinely
// owned by a live hero: the captive names that hero as leader, the hero still
// targets this captive, and Arrest_Hooligan is its active or resumable task.
declare
	agent hero;
begin
	hero = hooligan's "leader";

	if ( $IsValidGamePiece ( hero ))
		if ( $IsDead ( hero ) == FALSE )
			if ( hero's "Target" == hooligan )
				if ( hero's "ActiveScript" == $Arrest_Hooligan ||
					hero's "BackScript" == $Arrest_Hooligan )
					return TRUE;

	return FALSE;
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Pending_Reservations ( agent zoo ) is integer
///////////////////////////////////////////////////////////////////////////////
// A Mausoleum stores immediately after its stock capacity check. Zoo captives
// must travel, so count only Hooligans whose ordinary Target names this Zoo
// and whose stock arrest task is actually latched to a live hero. Flags and
// unlatched Hooligans do not consume visitor capacity.
declare
	list hidden_hooligans, hooligans;
	agent hooligan;
	integer reservations;
begin
	reservations = 0;

	$ListObjects ( zoo, "Hidden", -1, hidden_hooligans,
		#MyPlayer, #CheckSubtypes, "Hooligan", #NoHiddenMap );
	foreach hooligan in hidden_hooligans do
		begin
			if ( hooligan's "Target" == zoo )
				if ( $Restore_Is_Latched_Capture ( hooligan ))
					reservations ++;
		end

	$ListObjects ( zoo, "Hooligan", -1, hooligans,
		#MyPlayer, #NoHiddenMap );
	foreach hooligan in hooligans do
		begin
			if ( hooligan's "Target" == zoo )
				if ( $Restore_Is_Latched_Capture ( hooligan ))
					reservations ++;
		end

	return reservations;
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Refresh_Zoo_Capacity ( agent zoo )
///////////////////////////////////////////////////////////////////////////////
// Preserve the stock Zoo-specific legality attribute as the native placement
// gate's capacity bit.  The private ZCF0 validator reads this same bit before
// accepting an otherwise legal Monster target.
declare
	list visitors;
	integer occupied, limit;
begin
	if ( $IsValidGamePiece ( zoo ) == FALSE )
		return;

	visitors = zoo's "Occupants";
	occupied = $Restore_Zoo_Captive_Count ( zoo ) +
		$Restore_Zoo_Pending_Reservations ( zoo );
	limit = $Restore_Zoo_Visitor_Limit ( zoo );

	if ( occupied < limit )
		$SetAttribute ( zoo, #ATTRIB_Zoo_Legal_Target, 1 );
	else
		$SetAttribute ( zoo, #ATTRIB_Zoo_Legal_Target, 0 );
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Building_Birth ( agent zoo )
///////////////////////////////////////////////////////////////////////////////
// Literal Fairgrounds_Birth completion shape for the shared lifecycle we use:
// Building_Birth starts the declared RevenueScript at Revenue_Time. Generic
// Building lacks Palace.upgradescript2, so after initial completion repoint its
// existing function-valued birthScript2 slot to the private literal
// palace_upgrade2-shaped completion poll used only by later Zoo upgrades.
declare
begin
	$Building_Birth ( zoo );
	$Restore_Refresh_Zoo_Capacity ( zoo );
	zoo's "birthScript2" = $Restore_Zoo_Upgrade_Complete;
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Upgrade_Complete ( agent zoo )
///////////////////////////////////////////////////////////////////////////////
// Literal palace_upgrade2 timing and CurrentStageBuilt test. The sole Zoo
// substitution after completion is refreshing its level-derived capacity.
declare
begin
	if ( $GetAttribute ( zoo, #ATTRIB_CurrentStageBuilt ) != 1 )
		$RunThread (
			zoo's "birthScript2", #palace_upgrade_check, zoo );
	else
		begin
			// UpgradeAgentAttributes installs the next prototype's original
			// birthScript2 value; restore this upgrade callback for later levels.
			zoo's "birthScript2" = $Restore_Zoo_Upgrade_Complete;
			$Restore_Refresh_Zoo_Capacity ( zoo );
		end
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Zoo_Upgrade ( agent zoo )
///////////////////////////////////////////////////////////////////////////////
// Literal stock palace_upgrade timing shape: queue the building through
// basic_upgrade, then schedule the function-valued completion slot to perform
// the unchanged Palace_upgrade2 poll. Set the slot first so existing saves
// built before this correction enter the same upgrade lifecycle.
declare
begin
	$basic_upgrade ( zoo );
	zoo's "birthScript2" = $Restore_Zoo_Upgrade_Complete;
	$RunThread (
		zoo's "birthScript2", #palace_upgrade_check, zoo );
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Captive_Hooligan_Death ( agent thisagent )
///////////////////////////////////////////////////////////////////////////////
// Keep the complete stock Hooligan death lifecycle. Once it removes the dead
// captive from the pending Hooligan types, release that Zoo reservation.
declare
	agent zoo;
begin
	zoo = thisagent's "Target";
	$Hooligan_Death ( thisagent );

	if ( $IsValidGamePiece ( zoo ))
		$Restore_Refresh_Zoo_Capacity ( zoo );
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Find_Available_Zoo ( agent thisagent ) is agent
///////////////////////////////////////////////////////////////////////////////
// Literal stock Check_Mausoleum admission shape: query completed player-owned
// buildings, compare each Occupants list with its limit, and use the first
// legal building. Pending travel reservations fill the timing gap that the
// Mausoleum does not have because it hides and stores immediately.
declare
	list zoos, visitors, legal_zoos;
	agent zoo;
	integer occupied, limit;
begin
	$ListObjects ( thisagent, "building", -1, zoos,
		#MyPlayer, #CheckTitles, "Zoo", #ATTRIB_FirstStageBuilt, 1 );

	foreach zoo in zoos do
		begin
			visitors = zoo's "Occupants";
			occupied = $Restore_Zoo_Captive_Count ( zoo ) +
				$Restore_Zoo_Pending_Reservations ( zoo );
			limit = $Restore_Zoo_Visitor_Limit ( zoo );

			if ( occupied < limit )
				legal_zoos << zoo;
		end

	// Literal Check_Mausoleum control flow: build the legal list during
	// foreach, then select the first candidate only after the loop has ended.
	// Returning an agent result from inside foreach faults beta2's GPL evaluator.
	if ( $ListSize ( legal_zoos ) > 0 )
		begin
			zoo = $ListMember ( legal_zoos, 1 );
			return zoo;
		end

	return $NullAgent ();
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Find_Completed_Zoo ( agent thisagent ) is agent
///////////////////////////////////////////////////////////////////////////////
// The abandoned Zoo capture check required a completed player-owned Zoo before
// invoking Control_Monster. Admission is deliberately deferred until the
// controlled monster becomes a Hooligan, so a successful lethal roll can wait
// in the stock Hooligan lifecycle while every completed Zoo is temporarily full.
declare
	list zoos;
begin
	$ListObjects ( thisagent, "building", -1, zoos,
		#MyPlayer, #CheckTitles, "Zoo", #ATTRIB_FirstStageBuilt, 1 );

	if ( $ListSize ( zoos ) > 0 )
		return $ListMember ( zoos, 1 );

	return $NullAgent ();
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Controlled_To_Hooligan ( agent thisagent )
///////////////////////////////////////////////////////////////////////////////
// Control_Monster has now completed its literal fake_wander ->
// Become_Controlled lifecycle and invoked this function through BackScript.
// Release the temporary controlled-follower bookkeeping, then apply the proven
// Hooligan delivery data without replacing the stock control delay.
declare
	agent hero, zoo;
begin
	if ( $IsDead ( thisagent ))
		return;

	hero = thisagent's "leader";
	zoo = thisagent's "Target";

	if ( $IsValidGamePiece ( hero ))
		if ( hero's "Num_Followers" > 0 )
			( hero's "Num_Followers" ) --;

	$DeleteEffector ( thisagent, "Charm_icon" );
	$StopMoving ( thisagent );
	$ClearList ( thisagent's "Hostiles" );

	thisagent's "Type" = "Hooligan";
	thisagent's "Original_Type" = "Monster";
	thisagent's "EnemyType" = "hero";
	thisagent's "coord_home" = $LocationOf ( thisagent );
	thisagent's "Special_Boolean" = FALSE;
	thisagent's "Target" = zoo;
	thisagent's "BasicScript" = $Restore_Hooligan_Basic;
	thisagent's "BackScript" = $Restore_Hooligan_Basic;
	thisagent's "ActiveScript" = $Restore_Hooligan_Basic;
	thisagent's "IGDeathScript" = $Restore_Captive_Hooligan_Death;

	$SetAttribute ( thisagent, #ATTRIB_NotFlaggable, 1 );
	$SetAttribute ( thisagent, #ATTRIB_NotSpellTarget, 1 );
	$SetThreadInterval ( thisagent's "ActiveScript", #Henchmen_Cycle );

	// Control_Monster's temporary owner is not an arrest reservation. Release
	// that link after its follower count, then let the ordinary Hooligan Basic
	// lifecycle reserve one capacity slot only when a real arrest can begin.
	thisagent's "leader" = $NullAgent ();
	$Restore_Assign_Hooligan ( thisagent, $NullAgent () );

	if ( $IsValidGamePiece ( zoo ))
		$Restore_Refresh_Zoo_Capacity ( zoo );
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Assign_Hooligan ( agent thisagent, agent previous_owner ) is boolean
///////////////////////////////////////////////////////////////////////////////
// Stock Be_Dumb's successful Hooligan_Check handoff, applied directly because
// this mod is not allowed to replace every hero's native decision tree with
// the Wizard's Curse quest-wide Be_Dumb wrapper.  A hero already arresting a
// Hooligan and the hero who just abandoned this one are excluded.
declare
	list heroes, valid_heroes;
	agent hero, zoo;
	list visitors;
	integer committed, limit;
begin
	zoo = $Restore_Find_Available_Zoo ( thisagent );
	if ( $IsValidGamePiece ( zoo ))
		thisagent's "Target" = zoo;
	else
		return FALSE;

	// A queued Capture Flag may seek heroes only while the Zoo has room for a
	// new real arrest pairing. This is the same Occupants + pending comparison
	// used by the private placement gate; the unlatched current captive is not
	// yet part of Restore_Zoo_Pending_Reservations.
	visitors = zoo's "Occupants";
	committed = $Restore_Zoo_Captive_Count ( zoo ) +
		$Restore_Zoo_Pending_Reservations ( zoo );
	limit = $Restore_Zoo_Visitor_Limit ( zoo );
	if ( committed >= limit )
		begin
			$Restore_Refresh_Zoo_Capacity ( zoo );
			return FALSE;
		end

	$ListObjects ( thisagent, "Hero", -1, heroes, #NoHiddenMap );

	foreach hero in heroes do
		begin
			if ( hero != previous_owner )
				if ( $GetUnitPlayerNumber ( hero ) == #Player_1 )
					if ( $IsDead ( hero ) == FALSE )
						if ( hero's "SubType" == "Hero" )
							if ( hero's "ActiveScript" != $Arrest_Hooligan )
								if ( hero's "BackScript" != $Arrest_Hooligan )
									valid_heroes << hero;
		end

	if ( $ListSize ( valid_heroes ) > 0 )
		begin
			hero = $ListMember ( valid_heroes, 1 );
			thisagent's "leader" = hero;
			$SpecifyIntent ( hero, #intent_capturing_monster );
			hero's "Target" = thisagent;
			hero's "Counter" = 0;
			hero's "ActiveScript" = $Arrest_Hooligan;
			$Restore_Refresh_Zoo_Capacity ( zoo );
			return TRUE;
		end

	$Restore_Refresh_Zoo_Capacity ( zoo );
	return FALSE;
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Hooligan_Basic ( agent thisagent )
///////////////////////////////////////////////////////////////////////////////
// Literal stock Hooligan_Basic.  Its sole substitution is the private arrival
// function assigned after a player-1 hero targets this Hooligan.  If a prior
// owner abandoned the target, the same active lifecycle offers it to one
// different hero.
declare
	agent hero, owner;
	list heroes, player1_heroes;
	integer sight_range;
begin
	sight_range = $GetAttribute ( thisagent, #ATTRIB_SightRange );
	owner = thisagent's "leader";

	if ( $IsValidGamePiece ( owner ) == FALSE )
		$Restore_Assign_Hooligan ( thisagent, owner );
	else if ( $IsDead ( owner ))
		$Restore_Assign_Hooligan ( thisagent, owner );
	else if ( owner's "Target" != thisagent )
		$Restore_Assign_Hooligan ( thisagent, owner );
	else if ( owner's "ActiveScript" != $Arrest_Hooligan &&
		owner's "BackScript" != $Arrest_Hooligan )
		$Restore_Assign_Hooligan ( thisagent, owner );

	if ( $IsMoving ( thisagent ) == FALSE )
		begin
			if ( $RandomNumber ( 100 ) > 98 )
				$PerformAction (
					thisagent, thisagent's "Idle_action", $LocationOf ( thisagent ));
			else
				$Move ( thisagent, $RandomCoord ( thisagent's "coord_home",
					sight_range * #Hooligan_Wander_Mod ));
		end

	$ListObjects ( thisagent, "Hero", sight_range, heroes );
	heroes = $ListSubtypes ( heroes, "hero" );

	foreach hero in heroes do
		begin
			if ( $GetUnitPlayerNumber ( hero ) == #Player_1 )
				if ( hero's "Target" == thisagent )
					player1_heroes << hero;
		end

	if ( $ListSize ( player1_heroes ) > 0 )
		begin
			$StopMoving ( thisagent );
			$MessageFlag ( thisagent, #message_found_hooligan );
			thisagent's "Special_Boolean" = TRUE;
			thisagent's "ActiveScript" = $Restore_Hooligan_Goto_Zoo;
		end
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Hooligan_Goto_Zoo ( agent thisagent )
///////////////////////////////////////////////////////////////////////////////
// Stock Hooligan_Goto_Palace with the destination changed to the first
// completed Zoo.  The assigned hero is the single-owner link established by
// the abandoned Zoo's Control_Monster shape.  The stock arrest distance gates
// Hide so differing monster movement profiles cannot outrun their escort.
// The stock Zoo flag abandonment test releases an interrupted owner whenever
// that hero no longer targets this Hooligan.  Arrival resets the exact owner
// and stores the valid hidden Hooligan through the stock Mausoleum occupant
// handoff instead of deleting it.
declare
	list hooligans;
	agent zoo, AIRootAgent, owner;
	list visitors;
	integer limit;
begin
	zoo = thisagent's "Target";
	if ( $IsValidGamePiece ( zoo ) == FALSE )
		begin
			zoo = $Restore_Find_Available_Zoo ( thisagent );
			if ( $IsValidGamePiece ( zoo ) == FALSE )
				return;
			thisagent's "Target" = zoo;
		end

	AIRootAgent = $RetrieveAgent ( "GPLAiRoot" );

	owner = thisagent's "leader";

	// Literal stock zoo_flag_poll abandonment signal: a seeker that no longer
	// targets the flag's target has abandoned it.  Return this Hooligan to its
	// stock Basic lifecycle and reserve it for one different hero.
	// Stock Hooligan_Goto_Palace handles a successful Hide before any other
	// state transition. The private abandonment seam applies only while the
	// captive is still outside: Hide can complete between cycles after the hero
	// has naturally cleared its arrest task, and that completed arrival must not
	// be mistaken for an interruption and reassigned.
	if ( $IsHidden ( thisagent ) == FALSE )
		if ( $IsValidGamePiece ( owner ) == FALSE || $IsDead ( owner ) ||
			owner's "Target" != thisagent ||
			( owner's "ActiveScript" != $Arrest_Hooligan &&
			owner's "BackScript" != $Arrest_Hooligan ))
			begin
				if ( $IsMoving ( thisagent ))
					$StopMoving ( thisagent );
				thisagent's "Special_Boolean" = FALSE;
				thisagent's "ActiveScript" = $Restore_Hooligan_Basic;
				$Restore_Assign_Hooligan ( thisagent, owner );
				return;
			end

	// Stock formation tasks converge around their leader by distance.  Here
	// the destination-owning Hooligan pauses at the stock arrest radius instead,
	// allowing its assigned hero to catch up.
	if ( $DistanceBetweenAgents ( thisagent, owner ) >
		#Arrest_Hooligan_Dist )
		begin
			if ( $IsMoving ( thisagent ))
				$StopMoving ( thisagent );
		end
	else if ( $IsMoving ( thisagent ) == FALSE )
		$Hide ( thisagent, zoo );

	if ( $IsHidden ( thisagent ))
		begin
			// Stock Check_Mausoleum repeats its Occupants < limit test at
			// the same boundary that stores the agent. Preserve that final
			// admission check here: a lost/stale arrest reservation must never
			// allow a delivered captive to overfill the Zoo.
			visitors = zoo's "Occupants";
			limit = $Restore_Zoo_Visitor_Limit ( zoo );
			if ( $Restore_Zoo_Captive_Count ( zoo ) >= limit )
				begin
					if ( $IsValidGamePiece ( owner ))
						if ( $IsDead ( owner ) == FALSE )
							$Reset_Tasks ( owner );

					thisagent's "leader" = $NullAgent ();
					thisagent's "Special_Boolean" = FALSE;
					thisagent's "ActiveScript" = $Restore_Hooligan_Basic;
					$Restore_Refresh_Zoo_Capacity ( zoo );
					return;
				end

			$ListObjects ( zoo, "Hooligan", -1, hooligans, #NoHiddenMap );
			if ( $ListSize ( hooligans ) == 0 )
				begin
					$MessageFlag ( zoo, #message_arrested_all_hooligans );
					AIRootAgent's "Quest_Flag_2" = TRUE;

				end

			// The stock visitor callback runs only after travel has delivered the
			// agent.  Hide has now completed, so register this hidden captive
			// through that callback, give it a persistent occupant intent using
			// the same Enter_Building -> SpecifyIntent ordering as stock Lived_In,
			// then enter the stock-shaped periodic garrison exit lifecycle.
			$Enter_Building ( thisagent, zoo );

			// The final stock admission and occupant insertion are now complete;
			// release the exact arrest owner before ending the Hooligan lifecycle.
			if ( $IsValidGamePiece ( owner ))
				if ( $IsDead ( owner ) == FALSE )
					$Reset_Tasks ( owner );

			// The delivered Hooligan no longer has an arrest owner or an active
			// capture reservation. Clear both pieces of stock Hooligan ownership
			// state before installing its occupant lifecycle.
			thisagent's "leader" = $NullAgent ();
			thisagent's "Special_Boolean" = FALSE;
			thisagent's "Target" = $NullAgent ();
			$SpecifyIntent ( thisagent, #intent_waiting_in_zoo );
			$Restore_Refresh_Zoo_Capacity ( zoo );

			// Stock timed building visits set the current task's next interval
			// before changing ActiveScript. Also replace BasicScript and
			// BackScript: leaving either on Restore_Hooligan_Basic lets an
			// ordinary task reset restart arrest/delivery for an agent that is
			// already present in the Occupants list. Reset_Controlled restores all
			// three original monster scripts before any legitimate release.
			$SetThreadInterval (
				thisagent's "ActiveScript", #Restore_Zoo_Breakout_Period );
			thisagent's "BasicScript" = $Restore_Zoo_Breakout_Check;
			thisagent's "BackScript" = $Restore_Zoo_Breakout_Check;
			thisagent's "ActiveScript" = $Restore_Zoo_Breakout_Check;
		end
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Begin_Stock_Zoo_Control (
	agent thisagent, agent flag, agent zoo, agent hero )
///////////////////////////////////////////////////////////////////////////////
// Preserve the complete surviving Zoo success branch: one-third HP followed
// by the selected ruleset's actual Control_Monster.  BackScript is the private
// seam that runs only after stock fake_wander -> Become_Controlled completes.
declare
begin
	$SetAttribute ( thisagent, #ATTRIB_HP,
		$GetAttribute ( thisagent, #ATTRIB_MaxHP ) / 3 );
	$Control_Monster ( hero, thisagent );

	// Original Control_Monster temporarily used Dead; GPLMx corrected that to
	// Hidden. Use the corrected stock state in both selected rulesets so the
	// engine does not treat a successful capture as a corpse during the delay.
	thisagent's "Type" = "Hidden";
	thisagent's "SubType" = "Hooligan";
	thisagent's "Target" = zoo;
	thisagent's "BackScript" = $Restore_Controlled_To_Hooligan;

	// monster_gravestone is entered at the engine's lethal boundary. Its stock
	// corpse tail explicitly resumes the unit's paused ActiveScript before
	// redirecting it; successful Zoo control must do the same after
	// Control_Monster redirects that script to fake_wander, or the shipped
	// charm delay cannot advance into Become_Controlled and BackScript.
	$ResumeThread ( thisagent's "ActiveScript" );

	// The flag's stock death cleanup resets its seekers. Delete it now; the
	// temporary Control_Monster owner is released by Restore_Controlled_To_Hooligan
	// before capacity-aware Hooligan assignment begins.
	$DeleteGamePiece ( flag );
	$SetAttribute ( thisagent, #ATTRIB_NotFlaggable, 1 );
	$SetAttribute ( thisagent, #ATTRIB_NotSpellTarget, 1 );
	$Restore_Refresh_Zoo_Capacity ( zoo );
end

///////////////////////////////////////////////////////////////////////////////
function monster_gravestone ( agent thisagent )
///////////////////////////////////////////////////////////////////////////////
// Literal GPLMx monster_gravestone Zoo interception and stock failure tail.
// As in GPLMx, the lethal boundary calls one boolean Zoo check directly.
declare
	boolean deadflag;
begin
	deadflag = TRUE;
	$StopMoving ( thisagent );

	if ( $Restore_Stock_Zoo_Flag_Check ( thisagent ) == TRUE )
		deadflag = FALSE;

	if ( deadflag == TRUE )
		begin
			$DropGoldInRadius (
				thisagent, $GetAttribute ( thisagent, #ATTRIB_Gold ));
			thisagent's "Type" = "Dead";
			$ResumeThread ( thisagent's "ActiveScript" );
			thisagent's "ActiveScript" = $be_dead_2;
			$SetThreadInterval (
				thisagent's "ActiveScript", #gravestone_lifespan );
			$PerformAction ( thisagent, "basic_death", thisagent );
		end
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Capture_Flag_Birth ( agent thisagent )
///////////////////////////////////////////////////////////////////////////////
// Literal stock attack_flag_birth. Capture begins only from the stock GPLMx
// monster_gravestone interception above, leaving target callbacks untouched.
declare
	agent target;
	integer flagplayer, targetplayer;
begin
	$NewThread ( thisagent's "ActiveScript", #flag_Cycle, thisagent );
	thisagent's "gavereward" = FALSE;

	target = $agentnumber ( $getattribute ( thisagent, #ATTRIB_targetID ));
	targetplayer = $getunitplayernumber ( target );
	flagplayer = $getunitplayernumber ( thisagent );

	if ( targetplayer != #monster_player )
		if ( targetplayer != flagplayer )
			if ( $getplayerteamnumber ( target ) ==
				$getplayerteamnumber ( thisagent ) )
				begin
					$setplayerteamnumber ( thisagent, $newteamnumber () );
				end
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Capture_Flag_Poll ( agent thisagent )
///////////////////////////////////////////////////////////////////////////////
// Literal abandoned zoo_flag_poll. Unlike attack_flag_poll it does not pay or
// delete on target death; the target's scoped death callback owns the attempt.
declare
	list new_heroes;
	agent hero;
begin
	if ( $IsValidGamePiece ( thisagent ) == FALSE )
		return;

	if ( $ListSize ( thisagent's "heroes" ) > 0 )
		begin
			foreach hero in thisagent's "heroes" do
				begin
					if ( $IsDead ( hero ) == FALSE )
						if ( hero's "Target" == $AgentNumber (
							$GetAttribute ( thisagent, #ATTRIB_TargetID )))
							new_heroes << hero;
						else
							$ClearFlag ( hero );
				end
		end

	thisagent's "heroes" = new_heroes;
	$SetAttribute (
		thisagent, #ATTRIB_FlagSeekers, $ListSize ( new_heroes ));
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Capture_Flag_Death_Callback ( agent thisagent )
///////////////////////////////////////////////////////////////////////////////
// Literal abandoned zoo_flag_death_callback. Capture is called manually from
// monster_gravestone; automatic parent cleanup or player cancellation only
// deletes the private overlay.
declare
begin
	$DeleteGamePiece ( thisagent );
end

///////////////////////////////////////////////////////////////////////////////
function Restore_Capture_Flag_Death ( agent thisagent )
///////////////////////////////////////////////////////////////////////////////
// Literal abandoned Zoo flag seeker cleanup.
declare
	agent hero, target;
begin
	target = $AgentNumber (
		$GetAttribute ( thisagent, #ATTRIB_TargetID ));

	if ( $ListSize ( thisagent's "heroes" ) > 0 )
		begin
			foreach hero in thisagent's "heroes" do
				begin
					if ( $IsDead ( hero ) == FALSE )
						if ( hero's "Target" == target )
							$Reset_Tasks ( hero );
				end
		end
end

///////////////////////////////////////////////////////////////////////////////
// Literal abandoned GPLMx Zoo capture deployment
//
// These functions preserve the statement order in:
//   GPLMx/TaskModules/Buildings/Zoo.gpl
//   GPLMx/mx_Monster_Deaths.gpl
//
// Original rules lack both expansion-only fields used by the abandoned source.
// The private overlay death callback supplies its exact flag directly and the
// check computes the unchanged formula locally. No global or target state is
// added.
///////////////////////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////////////////////
function Restore_Stock_Zoo_Flag_Check ( agent thisagent ) is boolean
///////////////////////////////////////////////////////////////////////////////
declare
	agent zoo_agent, flag, hero, zoo;
	boolean subdueflag;
	integer cash, target_strength, charm_percentage;
	list flags, heroes, valid_heroes;
begin
	subdueflag = FALSE;

	// The native display classifier identifies the underlying Skeleton unit
	// class as a monster even after stock Skeleton_Birth turns a Priestess
	// summon into a player-owned Familiar/Controlled hero. Recheck the stock
	// gameplay ownership at the lethal boundary so controlled units continue
	// through Controlled_Monster_Death instead of crossing into Zoo storage.
	if ( thisagent's "Familiar" == TRUE )
		return FALSE;
	if ( $GetUnitPlayerNumber ( thisagent ) != #Monster_Player )
		return FALSE;

	// GPLMx reads Monster.zoo_agent here. Original does not declare that field,
	// so recover its value inside the same boolean check from the stock
	// RewardFlag list and engine-owned TargetID attachment. Keeping the lookup
	// local avoids the non-stock agent-return call at the lethal boundary.
	zoo_agent = $NullAgent ();
	$ListObjects ( thisagent, "RewardFlag", -1, flags, #RewardFlags );
	foreach flag in flags do
		begin
			if ( flag's "SubType" == "Capture_Flag" )
				if ( $AgentNumber (
						$GetAttribute ( flag, #ATTRIB_TargetID )) == thisagent )
					zoo_agent = flag;
		end

	if ( $IsValidGamePiece ( zoo_agent ))
		begin
			cash = $GetAttribute ( zoo_agent, #ATTRIB_RewardCost );
			target_strength = $GetAttribute ( thisagent, #ATTRIB_MaxHP );
			charm_percentage = 50 * (
				$Sqrt (( cash / 20.0 ) / target_strength ));
			if ( charm_percentage > 95 )
				charm_percentage = 95;
			if (( $RandomNumber ( 100 ) + 1 ) < charm_percentage )
				begin
					$ListObjects (
						thisagent, "Hero", -1, heroes, #NoHiddenMap );
					foreach hero in heroes do
						begin
							if ( $GetUnitPlayerNumber ( hero ) == #Player_1 )
								if ( $IsDead ( hero ) == FALSE )
									if ( hero's "SubType" == "Hero" )
										valid_heroes << hero;
					end

					if ( $ListSize ( valid_heroes ) > 0 )
						begin
							hero = $ListMember ( valid_heroes, 1 );
							zoo = $Restore_Find_Completed_Zoo ( zoo_agent );
							if ( $IsValidGamePiece ( zoo ))
								begin
									$Restore_Begin_Stock_Zoo_Control (
										thisagent, zoo_agent, zoo, hero );
									$SetAttribute (
										thisagent,
										#ATTRIB_HealingRateModifier, 1 );
									subdueflag = TRUE;
								end
						end
				end

			// The overlay callback owns failure cleanup. The success bridge
			// consumes the flag before capacity-aware Hooligan assignment.
		end

	return subdueflag;
end
